{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "outDir": "dist-tsc",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "customConditions": ["source"]
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }]
}
