{
  "name": "@gym/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DEV_AUTO_LOGIN=1 tsx watch --conditions=source src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx --conditions=source src/db/check.ts",
    "test": "vitest run",
    "set-password": "tsx --conditions=source src/cli/set-password.ts",
    "backup": "tsx --conditions=source src/cli/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@gym/shared": "*",
    "@node-rs/argon2": "^2.2.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
